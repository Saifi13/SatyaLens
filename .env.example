# ---- AI provider (any OpenAI-compatible chat completions API) ----
AI_API_KEY=
# Optional overrides:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---- Web search provider ----
# SEARCH_PROVIDER is "tavily" or "brave"
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Optional server port
# PORT=8787

# ---- Frontend API base URL (Vite only exposes VITE_* to the browser) ----
# Leave empty when the frontend and API share an origin (vite dev proxy / Express serving dist)
# or point it at the deployed API:
# VITE_API_BASE_URL=https://your-backend.onrender.com
